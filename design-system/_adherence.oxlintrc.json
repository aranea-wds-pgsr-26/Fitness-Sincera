{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/nav/**",
              "ui_kits/aluno/**",
              "ui_kits/nutricionista/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Archivo|Anton|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Archivo, Anton, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|initials|size|tone|ring|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, initials, size, tone, ring."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:slate|dark|green|lime)$/]",
        "message": "<Avatar> tone must be one of 'slate' | 'dark' | 'green' | 'lime'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|solid|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, solid, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|lime|green|purple|amber|rose|protein|carbs|fat)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'lime' | 'green' | 'purple' | 'amber' | 'rose' | 'protein' | 'carbs' | 'fat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brand'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|onDark|key|ref|className|style|children)$/]",
        "message": "<Brand> doesn't accept that prop. Declared props: variant, size, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brand'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:wordmark|full)$/]",
        "message": "<Brand> variant must be one of 'wordmark' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|block|uppercase|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, block, uppercase, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|green|purple|dark|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'green' | 'purple' | 'dark' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:pad|radius|interactive|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: pad, radius, interactive, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|radius|glow|children|key|ref|className|style|children)$/]",
        "message": "<IconTile> doesn't accept that prop. Declared props: tone, size, radius, glow, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lime|green|purple|dark|slate|white)$/]",
        "message": "<IconTile> tone must be one of 'lime' | 'green' | 'purple' | 'dark' | 'slate' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|context|count|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: icon, label, active, context, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute[name.name='context'] > Literal[value!=/^(?:lime|purple)$/]",
        "message": "<NavItem> context must be one of 'lime' | 'purple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|height|track|animate|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, tone, height, track, animate."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lime|purple|green|slate)$/]",
        "message": "<ProgressBar> tone must be one of 'lime' | 'purple' | 'green' | 'slate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RingGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|stroke|tone|label|valueText|key|ref|className|style|children)$/]",
        "message": "<RingGauge> doesn't accept that prop. Declared props: value, size, stroke, tone, label, valueText."
      },
      {
        "selector": "JSXOpeningElement[name.name='RingGauge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:purple|lime|green)$/]",
        "message": "<RingGauge> tone must be one of 'purple' | 'lime' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|slot|onClick|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, slot, onClick."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
